# ==============================================================================
# MULTI-COMPANY / MULTI-TENANT BRAND CONFIGURATION (.env.example)
# Copy this file to .env and modify to white-label the authentication module for any company.
# ==============================================================================

# Company Brand Identity
VITE_COMPANY_NAME="Acme Corp"
VITE_COMPANY_BADGE="SSO PLATFORM"

# Company Logo URL (Leave empty to use the built-in modern Shield icon)
# Example: VITE_COMPANY_LOGO_URL="https://yourcompany.com/logo.png"
VITE_COMPANY_LOGO_URL=""

# Favicon & Page Title
VITE_FAVICON_URL="/favicon.svg"
VITE_APP_TITLE="Acme Corp Workspace Login"

# Footer Legal & Architecture Notice
VITE_FOOTER_COPYRIGHT="Protected by Acme Corp Zero-Trust Architecture. All rights reserved."

# Default Theme ('light' or 'dark')
VITE_DEFAULT_THEME="light"
