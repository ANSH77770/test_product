# ==============================================================================
# MULTI-COMPANY / MULTI-TENANT BRAND CONFIGURATION (.env)
# Modify this single file to white-label the authentication module for any company.
# ==============================================================================

# Company Brand Identity
VITE_COMPANY_NAME="Orane Consulting Pvt Ltd"
VITE_COMPANY_BADGE="SAP ENTERPRISE"

# Company Logo URL (Leave empty or comment out to use the built-in modern Shield icon)
# Example: VITE_COMPANY_LOGO_URL="https://yourcompany.com/logo.png"
VITE_COMPANY_LOGO_URL="Https://www.oraneconsulting.com/favicon.ico"

# Favicon & Page Title
VITE_FAVICON_URL="Https://www.oraneconsulting.com/favicon.ico"
VITE_APP_TITLE="ApexAuth Enterprise SSO"

# Footer Legal & Architecture Notice
VITE_FOOTER_COPYRIGHT="We’re hiring ! Learn about careers at Orane"

# Default Theme ('light' or 'dark')
VITE_DEFAULT_THEME="light"
